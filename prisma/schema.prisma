generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  savedColleges SavedCollege[]
  reviews       Review[]
}

model College {
  id          String   @id @default(cuid())
  name        String
  location    String
  state       String
  fees        Int
  rating      Float
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())

  courses       Course[]
  reviews       Review[]
  savedBy       SavedCollege[]
}

model Course {
  id        String  @id @default(cuid())
  name      String
  duration  String
  fees      Int
  college   College @relation(fields: [collegeId], references: [id])
  collegeId String
}

model Review {
  id        String   @id @default(cuid())
  rating    Float
  comment   String
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    String
  college   College @relation(fields: [collegeId], references: [id])
  collegeId String
}

model SavedCollege {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    String
  college   College @relation(fields: [collegeId], references: [id])
  collegeId String

  @@unique([userId, collegeId])
}